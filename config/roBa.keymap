#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <125>;
    tapping-term-ms = <175>;
};

&lt {
    tapping-term-ms = <175>;
    quick-tap-ms = <125>;
    flavor = "tap-preferred";
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <7 8>;
        };

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
        };
    };

    macros {
        Add: to_layer_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CARET>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SEMICOLON>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp CARET>;

            label = "TO_LAYER_0";
        };

        Delete: Delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CARET>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp CARET>;

            label = "DELETE";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&Add>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W        &kp E             &kp R  &kp T                                    &kp Y                      &kp U    &kp I      &kp O    &kp P
&mt LEFT_SHIFT A  &mt LCTRL S  &mt LEFT_ALT D    &kp F  &kp G        &none          &none        &kp H                      &lt 3 J  &kp K      &kp L    &mt RCTRL ENTER
&lt 5 Z           &kp X        &kp C             &kp V  &kp B        &none          &none        &kp N                      &kp M    &kp COMMA  &kp DOT  &kp MINUS
&lt 6 ESC         &kp F7       &mt LEFT_ALT F10  &mo 1  &lt 3 SPACE  &lt 2 TAB      &lt 3 GRAVE  &mt RIGHT_SHIFT BACKSPACE                               &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&kp LS(N5)    &kp LS(DOLLAR)    &kp LS(NUMBER_6)      &kp LS(INT1)       &kp SLASH                          &kp INT3              &kp LS(RIGHT_BRACKET)  &kp LS(NUHS)      &kp LESS_THAN     &kp GREATER_THAN
&kp LS(INT3)  &kp LS(NUMBER_3)  &kp LS(SINGLE_QUOTE)  &kp LS(SEMICOLON)  &kp LS(MINUS)  &none       &none   &kp LEFT_BRACKET      &kp LS(NUMBER_8)       &kp LS(NUMBER_9)  &kp SEMICOLON     &kp SINGLE_QUOTE
&kp EQUAL     &kp LS(EQUAL)     &trans                &kp LS(NUMBER_1)   &kp LS(SLASH)  &none       &none   &kp LS(LEFT_BRACKET)  &kp RIGHT_BRACKET      &kp NUHS          &kp LS(NUMBER_7)  &kp NUMBER_2
&trans        &trans            &trans                &trans             &trans         &trans      &trans  &trans                                                                           &kp F12
            >;
        };

        NUM {
            bindings = <
&none  &none  &none  &none  &none                    &kp SLASH         &kp N7  &kp N8  &kp N9  &kp COMMA
&none  &none  &none  &none  &none  &none      &none  &kp SINGLE_QUOTE  &kp N4  &kp N5  &kp N6  &kp N0
&none  &none  &none  &none  &none  &none      &none  &kp LS(EQUAL)     &kp N1  &kp N2  &kp N3  &kp PERIOD
&none  &none  &none  &none  &none  &none      &none  &none                                     &none
            >;
        };

        ARROW {
            bindings = <
&kp LC(W)       &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &Add                           &kp PAGE_UP            &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_DOWN
&kp LEFT_SHIFT  &kp LCTRL           &kp LEFT_ALT      &kp TAB              &Delete  &none      &none      &kp LA(LEFT_ARROW)     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)
&kp LC(T)       &kp LC(X)           &kp LC(C)         &kp LC(V)            &none    &none      &none      &kp LC(PAGE_UP)        &kp F2          &kp F5          &kp F4           &kp LC(PAGE_DOWN)
&none           &none               &none             &none                &none    &none      &kp LG(V)  &mt LEFT_SHIFT DELETE                                                   &kp F2
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&none  &none  &none  &none  &none                     &trans  &trans    &trans    &trans    &trans
&none  &none  &none  &none  &none  &none      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&none  &none  &none  &none  &none  &none      &trans  &trans  &trans    &trans    &trans    &trans
&none  &none  &none  &none  &none  &none      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none  &none                    &none      &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(LS(S))
&none  &none  &none  &none  &none  &none      &none  &none      &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &kp LC(N1)
&none  &none  &none  &none  &none  &none      &none  &kp RG(R)  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LC(N2)
&none  &none  &none  &none  &none  &none      &none  &none                                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
